# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file or share the API key.

# Your Swapcard organizer API key (from Studio > Developer API & Webhooks,
# or issued by dev@swapcard.com scoped to your event).
SWAPCARD_API_KEY=

# The Swapcard ID of the EA Summit event (or your sub-event) you're checking
# people into. You can get this from the event URL in Studio, or by querying
# the "events" list with your API key.
SWAPCARD_EVENT_ID=

# Optional: port for the local server (defaults to 3000)
PORT=3000
